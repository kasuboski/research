<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Phoenix Framework">
      <%= assigns[:page_title] || "SaasStarter" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-white antialiased">
    <div class="min-h-screen flex flex-col">
      <!-- Header -->
      <header class="px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between border-b border-zinc-100 py-3">
          <div class="flex items-center gap-4">
            <a href="/">
              <h1 class="text-2xl font-bold text-zinc-900">SaasStarter</h1>
            </a>
          </div>
          <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
            <a
              href={~p"/auth/sign_in"}
              class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
            >
              Sign In
            </a>
            <a
              href={~p"/auth/register"}
              class="rounded-lg bg-blue-600 px-2 py-1 text-white hover:bg-blue-700"
            >
              Get Started
            </a>
          </div>
        </div>
      </header>
      <!-- Main Content -->
      <main class="flex-1 px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="text-center">
            <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl">
              Welcome to Your SaaS Starter Kit
            </h1>
            <p class="mt-6 text-lg leading-8 text-zinc-600">
              Built with Phoenix, LiveView, and Ash Framework. Your foundation for building
              production-ready SaaS applications.
            </p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
              <a
                href={~p"/auth/register"}
                class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
              >
                Get started
              </a>
              <a
                href="https://hexdocs.pm/phoenix/overview.html"
                class="text-sm font-semibold leading-6 text-zinc-900"
              >
                Learn more <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="mt-20">
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
              <!-- Feature 1 -->
              <div class="rounded-lg border border-zinc-200 p-6">
                <h3 class="text-lg font-semibold text-zinc-900">Phoenix Framework</h3>
                <p class="mt-2 text-sm text-zinc-600">
                  Built on Phoenix 1.7 with LiveView for real-time, interactive experiences.
                </p>
              </div>
              <!-- Feature 2 -->
              <div class="rounded-lg border border-zinc-200 p-6">
                <h3 class="text-lg font-semibold text-zinc-900">Ash Framework</h3>
                <p class="mt-2 text-sm text-zinc-600">
                  Declarative resource modeling with built-in authentication and authorization.
                </p>
              </div>
              <!-- Feature 3 -->
              <div class="rounded-lg border border-zinc-200 p-6">
                <h3 class="text-lg font-semibold text-zinc-900">Ready to Deploy</h3>
                <p class="mt-2 text-sm text-zinc-600">
                  Production-ready configuration with database, email, and authentication setup.
                </p>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
